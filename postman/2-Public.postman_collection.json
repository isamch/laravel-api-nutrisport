			"name": "Products",
			"item": [
				{
					"name": "Get All Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/public/products",
							"host": ["{{base_url}}"],
							"path": ["api", "public", "products"]
						}
					}
				},
				{
					"name": "Get Products - France",
					"request": {
						"method": "GET",
						"header": [],
